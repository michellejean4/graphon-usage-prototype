{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "graphon-usage",
  "homepage": "https://graphon-usage-prototype.vercel.app",
  "items": [
    {
      "name": "graphon-theme",
      "type": "registry:theme",
      "title": "Graphon theme",
      "description": "shadcn neutral plus the upgrade colour, usage chart colours and GitHub-style dark mode.",
      "cssVars": {
        "theme": {
          "color-upgrade": "var(--upgrade)",
          "color-upgrade-foreground": "var(--upgrade-foreground)",
          "color-upgrade-hover": "var(--upgrade-hover)",
          "color-upgrade-text": "var(--upgrade-text)",
          "color-topbar": "var(--topbar)",
          "color-success": "var(--success)",
          "color-success-text": "var(--success-text)",
          "color-warning": "var(--warning)",
          "color-warning-text": "var(--warning-text)"
        },
        "light": {
          "chart-1": "#2f6fe4",
          "chart-2": "#f5b80f",
          "chart-3": "#7a64ec",
          "upgrade": "#1a5ccf",
          "upgrade-foreground": "#ffffff",
          "upgrade-hover": "#154bb0",
          "upgrade-text": "#1a5ccf",
          "topbar": "oklch(98.5% 0 0)",
          "success": "oklch(59% 0.18 150)",
          "success-text": "oklch(50.8% 0.118 165.612)",
          "warning": "#111111",
          "warning-text": "oklch(14.5% 0 0)"
        },
        "dark": {
          "background": "#010409",
          "foreground": "#f0f6fc",
          "card": "#0d1117",
          "card-foreground": "#f0f6fc",
          "popover": "#151b23",
          "popover-foreground": "#f0f6fc",
          "secondary": "#212830",
          "secondary-foreground": "#f0f6fc",
          "muted": "#151b23",
          "muted-foreground": "#9198a1",
          "accent": "#212830",
          "accent-foreground": "#f0f6fc",
          "border": "rgb(61 68 77 / 0.7)",
          "input": "#3d444d",
          "ring": "#656c76",
          "sidebar": "#0d1117",
          "sidebar-foreground": "#f0f6fc",
          "sidebar-accent": "#212830",
          "sidebar-accent-foreground": "#f0f6fc",
          "sidebar-border": "rgb(61 68 77 / 0.7)",
          "chart-1": "#3a64cc",
          "chart-2": "#d19a2a",
          "chart-3": "#7766ee",
          "upgrade": "#1f63d6",
          "upgrade-foreground": "#ffffff",
          "upgrade-hover": "#2668da",
          "upgrade-text": "#5b93ec",
          "topbar": "#010409",
          "success": "oklch(72% 0.17 150)",
          "success-text": "oklch(76.5% 0.177 163.223)",
          "warning": "#f2f0eb",
          "warning-text": "#f0f6fc"
        }
      },
      "css": {
        ".dark [data-slot=\"meter-indicator\"][data-color=\"chart-1\"]": {
          "background-image": "linear-gradient(90deg, #3d72e0, #3159bd 70%, #213f99)"
        },
        ".dark [data-slot=\"meter-indicator\"][data-color=\"chart-2\"]": {
          "background-image": "linear-gradient(90deg, #e7ab2e, #c08a1c 70%, #8f6208)"
        },
        ".dark [data-slot=\"meter-indicator\"][data-color=\"chart-3\"]": {
          "background-image": "linear-gradient(90deg, #7a66ea, #5f4ed2 70%, #4535a8)"
        }
      }
    },
